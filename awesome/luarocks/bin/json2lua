#!/bin/sh

LUAROCKS_SYSCONFDIR='/etc/luarocks' exec '/usr/bin/lua' -e 'package.path="/home/dobefu/.config/awesome/luarocks/share/lua/5.4/?.lua;/home/dobefu/.config/awesome/luarocks/share/lua/5.4/?/init.lua;"..package.path;package.cpath="/home/dobefu/.config/awesome/luarocks/lib/lua/5.4/?.so;"..package.cpath;local k,l,_=pcall(require,"luarocks.loader") _=k and l.add_context("lua-cjson","2.1.0.6-1")' '/home/dobefu/.config/awesome/luarocks/lib64/luarocks/rocks-5.4/lua-cjson/2.1.0.6-1/bin/json2lua' "$@"
