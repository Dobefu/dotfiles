;vim:ft=dosini

[bar/i3bar]
monitor = ${env:MONITOR:}

modules-left = i3
modules-right = cpu memory volume battery date


height = 30
spacing = 0
background = ${colors.background}
module-margin = 1
padding-right = 2

tray-position = right
tray-maxsize = 24
tray-padding = 0

font-0 = NotoSans:size=14;2
font-1 = Font Awesome 5 Free:style=Solid:size=14;2
font-2 = Hack-Regular:size=14;2


[colors]
background = #000000
background-focused = #111188
background-urgent = #66ff4444

foreground = #ffffff
foreground-dim = #66ffffff


;
; Modules
;

[module/date]
type = internal/date
interval = 1

label = " %date%     %time%"
date = %{F#ddd}%d %B %Y%%{F-}
time = %{F#fff}%H:%M:%S%{F-}


[module/i3]
type = internal/i3

index-sort = true
wrapping-scroll = false
fuzzy-match = true
enable-scroll = false
enable-click = true
pin-workspaces = true

label-mode = " %mode% "

label-unfocused = %name%
label-unfocused-background = ${colors.background}
label-unfocused-padding = 2

label-focused = %name%
label-focused-background = ${colors.background-focused}
label-focused-padding = 2
label-focused-underline = ${colors.foreground-dim}

label-visible = %name%
label-visible-padding = 2

label-urgent = %name%
label-urgent-background = ${colors.background-urgent}
label-urgent-padding = 2


[module/cpu]
type = internal/cpu
interval = 5
format-foreground = ${colors.foreground}
format-prefix-foreground = ${colors.foreground}
format = %{A:ksysguard:}<label> <ramp-coreload>  %{A}
label =  %percentage%%

ramp-coreload-spacing = 0
ramp-coreload-0 = ▁
ramp-coreload-1 = ▂
ramp-coreload-2 = ▃
ramp-coreload-3 = ▄
ramp-coreload-4 = ▅
ramp-coreload-5 = ▆
ramp-coreload-6 = ▇
ramp-coreload-7 = █

[module/memory]
type = internal/memory
interval = 5

format = %{A:ksysguard:}<label> <bar-used>  %{A}
label =  %gb_used%

bar-used-indicator = 
bar-used-width = 8
bar-used-fill = %{T3}█%{T-}
bar-used-empty = %{T3}▁%{T-}


[settings]
screenchange-reload = true


[module/volume]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>
label-volume = "%percentage%%  "

format-muted = <label-muted>
label-muted = "  "
label-muted-foreground = #333
ramp-volume-0 = 
ramp-volume-0-foreground = #999
ramp-volume-1 = 
ramp-volume-2 = 


[module/battery]
type = internal/battery
battery = BAT0
adapter = ADP1
full-at = 100

format-charging = "<animation-charging> <label-charging>  "
format-discharging = "<ramp-capacity> <label-discharging>  "
label-full = " %percentage%%  "

ramp-capacity-0 = 
ramp-capacity-0-foreground = #f00
ramp-capacity-1 = 
ramp-capacity-1-foreground = #bb0
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 

animation-charging-0 = 
animation-charging-1 = 
animation-charging-2 = 
animation-charging-3 = 
animation-charging-4 = 
animation-charging-framerate = 500
